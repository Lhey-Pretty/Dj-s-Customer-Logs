{{> head}}
<body class="bg-[#fffdf2] dark:bg-[#0f0f0f] min-h-screen">
  <div class="min-h-screen md:flex">
    {{> staffSidebar activeSection="dashboard"}}
    <main id="dashboard" class="flex-1 px-4 py-8 lg:px-8">
      <header class="mb-8 rounded-2xl bg-[#171717] p-6 text-white shadow-lg">
        <p class="text-sm font-medium uppercase tracking-widest text-[#f7d83d]">Staff workspace</p>
        <h1 class="mt-2 text-3xl font-bold">Customer Logs Dashboard</h1>
        <p class="mt-2 text-[#f5edbd] opacity-80">Record and monitor customer activity for FoodHuB.</p>
      </header>

      <!-- Stats Cards -->
      <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <article class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-5 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#fff8d8] dark:bg-[#2a2500] text-[#75651d] dark:text-[#f7d83d]">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
            </span>
            <p class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wide">Total registered</p>
          </div>
          <p class="mt-4 text-3xl font-bold text-[#171717] dark:text-white">{{ stats.totalCustomers }}</p>
          <p class="mt-1 text-sm text-[#75651d] dark:text-[#f5edbd]">Total Customers</p>
        </article>
        <article class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-5 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#fff8d8] dark:bg-[#2a2500] text-[#75651d] dark:text-[#f7d83d]">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
              </svg>
            </span>
            <p class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wide">All-time records</p>
          </div>
          <p class="mt-4 text-3xl font-bold text-[#171717] dark:text-white">{{ stats.totalLogs }}</p>
          <p class="mt-1 text-sm text-[#75651d] dark:text-[#f5edbd]">Total Purchase Logs</p>
        </article>
        <article class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-5 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#fff8d8] dark:bg-[#2a2500] text-[#75651d] dark:text-[#f7d83d]">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
            </span>
            <p class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wide">Today's records</p>
          </div>
          <p class="mt-4 text-3xl font-bold text-[#171717] dark:text-white">{{ stats.todayPurchases }}</p>
          <p class="mt-1 text-sm text-[#75651d] dark:text-[#f5edbd]">Today's Purchases</p>
        </article>
        <article class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-5 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#fff8d8] dark:bg-[#2a2500] text-[#75651d] dark:text-[#f7d83d]">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
              </svg>
            </span>
            <p class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wide">Redeemed promos</p>
          </div>
          <p class="mt-4 text-3xl font-bold text-[#171717] dark:text-white">{{ stats.promoCount }}</p>
          <p class="mt-1 text-sm text-[#75651d] dark:text-[#f5edbd]">Promo Redemptions</p>
        </article>
      </section>

      <!-- Chart + Top Customers -->
      <div class="mt-6 grid gap-6 lg:grid-cols-3">
        <section class="lg:col-span-2 rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-6 shadow-sm">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-lg font-bold text-[#171717] dark:text-white">Purchase Activity</h2>
              <p class="text-sm text-gray-500 dark:text-gray-400">Last 7 days</p>
            </div>
            <span class="rounded-full bg-[#fff8d8] dark:bg-[#2a2500] px-3 py-1 text-xs font-medium text-[#75651d] dark:text-[#f7d83d]">Actual records</span>
          </div>
          <div class="flex h-48 items-end gap-2 border-b border-gray-200 dark:border-[#2d2d2d] px-1">
            {{#each chartDays}}<div class="flex h-full flex-1 flex-col items-center justify-end gap-1">
              <span class="text-xs text-gray-500 dark:text-gray-400">{{purchases}}</span>
              <div class="w-full max-w-12 rounded-t-lg bg-[#f7d83d] hover:bg-[#d6a500] transition-colors" style="height: {{height}}%; min-height: 4px;"></div>
              <span class="text-xs text-gray-600 dark:text-gray-400">{{label}}</span>
            </div>{{/each}}
          </div>
        </section>

        <section class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-6 shadow-sm">
          <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-4">Top Customers</h2>
          <div class="grid gap-3">
            {{#each topCustomers}}
            <div class="flex items-center justify-between rounded-xl bg-[#fffdf2] dark:bg-[#111] border border-[#ead36a] dark:border-[#2d2d2d] p-3">
              <div>
                <p class="font-semibold text-sm text-[#171717] dark:text-white">{{name}}</p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{{customerId}}</p>
              </div>
              <span class="rounded-full bg-[#f7d83d] px-3 py-1 text-xs font-bold text-[#171717]">{{purchases}} orders</span>
            </div>
            {{else}}
            <p class="text-sm text-gray-400 dark:text-gray-500 text-center py-4">No purchase data yet.</p>
            {{/each}}
          </div>
        </section>
      </div>

      <!-- Recent Logs -->
      <section class="mt-6 rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-[#171717] dark:text-white">Recent Activity</h2>
          <a href="/staff/modules/logs" class="text-xs font-semibold text-[#75651d] dark:text-[#f7d83d] hover:underline">View all &rarr;</a>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-[#ead36a] dark:border-[#2d2d2d]">
                <th class="p-3 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">Customer</th>
                <th class="p-3 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">Type</th>
                <th class="p-3 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">Date & Time</th>
              </tr>
            </thead>
            <tbody>
              {{#each recentLogs}}
              <tr class="border-b border-[#f1e8ae] dark:border-[#1f1f1f] hover:bg-[#fffdf2] dark:hover:bg-[#111] transition-colors">
                <td class="p-3 font-medium text-[#171717] dark:text-white">{{Customer.name}}</td>
                <td class="p-3"><span class="rounded-full bg-[#fff8d8] dark:bg-[#2a2500] px-3 py-1 text-xs font-semibold text-[#75651d] dark:text-[#f7d83d]">{{activityType}}</span></td>
                <td class="p-3 text-gray-500 dark:text-gray-400 text-xs">{{activityAt}}</td>
              </tr>
              {{else}}
              <tr><td class="p-3 text-gray-400 dark:text-gray-500" colspan="3">No recent activity.</td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
{{> footer}}
