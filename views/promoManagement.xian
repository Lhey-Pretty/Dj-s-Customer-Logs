{{> head}}
<body class="bg-[#fffdf2] dark:bg-[#0f0f0f] min-h-screen">
  <div class="min-h-screen md:flex">
    {{> adminSidebar activeSection="promo-management"}}
    <main class="flex-1 px-4 py-8 lg:px-8">
      <header class="mb-6 rounded-2xl bg-[#171717] p-6 text-white shadow-lg">
        <p class="text-xs uppercase tracking-widest text-[#f7d83d] font-semibold">Admin workspace</p>
        <h1 class="mt-2 text-3xl font-bold">Promo Management</h1>
        <p class="mt-2 text-[#f5edbd] opacity-80">Set promotion rules. POS applies the actual discount.</p>
      </header>

      <section class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-6 shadow-sm mb-6">
        <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-4">Create New Promo</h2>
        <form class="grid gap-3 md:grid-cols-2 lg:grid-cols-5" method="POST" action="/admin/promos">
          <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="name" placeholder="Promo name" required />
          <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="mechanics" placeholder="Mechanics e.g. Buy 5, get 1 free" required />
          <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="minimumPurchases" type="number" min="0" placeholder="Minimum purchases" required />
          <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="startDate" type="date" required />
          <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="endDate" type="date" required />
          <button class="rounded-xl bg-[#171717] dark:bg-[#f7d83d] px-4 py-2.5 font-semibold text-[#f7d83d] dark:text-[#171717] hover:opacity-90 transition-all lg:col-span-5 shadow-sm" type="submit">Create Promo</button>
        </form>
      </section>

      <section class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-6 shadow-sm">
        <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-4">Available Promotions</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {{#each promos}}
          <article class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-[#fffdf2] dark:bg-[#111] p-5 shadow-sm">
            <div class="flex items-start justify-between mb-3">
              <h3 class="font-bold text-[#171717] dark:text-white">{{name}}</h3>
              <span class="rounded-full px-3 py-1 text-xs font-semibold {{#ifEquals status "active"}}bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400{{else}}bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400{{/ifEquals}}">{{status}}</span>
            </div>
            <form class="grid gap-2" method="POST" action="/admin/promos/{{promoId}}">
              <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="name" value="{{name}}" required />
              <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="mechanics" value="{{mechanics}}" required />
              <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="minimumPurchases" type="number" min="0" value="{{minimumPurchases}}" required />
              <div class="grid grid-cols-2 gap-2">
                <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="startDate" type="date" value="{{startDate}}" required />
                <input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="endDate" type="date" value="{{endDate}}" required />
              </div>
              <button class="rounded-xl bg-[#171717] dark:bg-[#f7d83d] px-3 py-2 text-xs font-semibold text-[#f7d83d] dark:text-[#171717] hover:opacity-90 transition-all" type="submit">Save Changes</button>
            </form>
            <div class="mt-3 flex gap-2">
              <form method="POST" action="/admin/promos/{{promoId}}/toggle">
                <button class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] px-3 py-2 text-xs font-semibold text-[#75651d] dark:text-[#f7d83d] hover:bg-[#f7d83d] hover:text-[#171717] transition-all" type="submit">Activate / Deactivate</button>
              </form>
              <form method="POST" action="/admin/promos/{{promoId}}/delete" onsubmit="return confirm('Delete this promo? This cannot be undone.')">
                <button class="rounded-xl border border-red-300 dark:border-red-800 px-3 py-2 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-600 hover:text-white transition-all" type="submit">Delete</button>
              </form>
            </div>
          </article>
          {{else}}
          <p class="text-sm text-gray-400 dark:text-gray-500 col-span-2 py-4 text-center">No promotions created yet.</p>
          {{/each}}
        </div>
      </section>
    </main>
  </div>
{{> footer}}
