<aside class="w-full shrink-0 bg-[#171717] p-5 text-white md:flex md:min-h-screen md:w-64 md:flex-col shadow-xl">
  <div class="flex items-center gap-3 border-b border-[#2d2d2d] pb-5">
    <img src="/foodhub-logo.png" alt="FoodHuB logo" class="h-14 w-14 rounded-xl object-contain shadow-md" />
    <div>
      <p class="font-bold text-[#f7d83d] text-lg leading-tight">FoodHuB</p>
      <p class="text-xs text-[#f5edbd] opacity-75">Customer Logs</p>
    </div>
  </div>
  <nav class="mt-6 grid gap-1" aria-label="Staff Customer Logs functions">
    <a href="/staff/dashboard" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all {{#ifEquals activeSection "dashboard"}}bg-[#f7d83d] text-[#171717] shadow-md font-bold{{else}}text-[#f5edbd] hover:bg-[#2d2d2d] hover:text-white{{/ifEquals}}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      <span>Dashboard</span>
    </a>
    <a href="/staff/modules/customers" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all {{#ifEquals activeSection "customers"}}bg-[#f7d83d] text-[#171717] shadow-md font-bold{{else}}text-[#f5edbd] hover:bg-[#2d2d2d] hover:text-white{{/ifEquals}}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
      </svg>
      <span>Customers</span>
    </a>
    <a href="/staff/modules/logs" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all {{#ifEquals activeSection "logs"}}bg-[#f7d83d] text-[#171717] shadow-md font-bold{{else}}text-[#f5edbd] hover:bg-[#2d2d2d] hover:text-white{{/ifEquals}}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
      </svg>
      <span>Customer Logs</span>
    </a>
    <a href="/staff/modules/promos" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all {{#ifEquals activeSection "promos"}}bg-[#f7d83d] text-[#171717] shadow-md font-bold{{else}}text-[#f5edbd] hover:bg-[#2d2d2d] hover:text-white{{/ifEquals}}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
      </svg>
      <span>Promo Records</span>
    </a>
    <a href="/staff/modules/loyalty" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all {{#ifEquals activeSection "loyalty"}}bg-[#f7d83d] text-[#171717] shadow-md font-bold{{else}}text-[#f5edbd] hover:bg-[#2d2d2d] hover:text-white{{/ifEquals}}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
      </svg>
      <span>Loyalty Records</span>
    </a>
    <a href="/staff/modules/reports" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all {{#ifEquals activeSection "reports"}}bg-[#f7d83d] text-[#171717] shadow-md font-bold{{else}}text-[#f5edbd] hover:bg-[#2d2d2d] hover:text-white{{/ifEquals}}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
      </svg>
      <span>Reports</span>
    </a>
  </nav>
  <a href="/logout" class="mt-6 flex items-center justify-center gap-2 rounded-xl border border-[#f7d83d]/50 px-4 py-3 text-center text-sm font-semibold text-[#f7d83d] hover:bg-[#f7d83d] hover:text-[#171717] transition-all md:mt-auto">
    <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
    </svg>
    <span>Logout</span>
  </a>
</aside>
