{{> head}}
<body class="bg-[#fffdf2] dark:bg-[#0f0f0f] min-h-screen">
  <div class="flex min-h-screen items-center justify-center px-4 py-8">
    <div class="w-full max-w-md rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-8 shadow-xl text-center">
      <img src="/foodhub-logo.png" alt="FoodHuB logo" class="mx-auto mb-4 h-24 w-24 rounded-2xl object-contain shadow-md" />
      <h1 class="text-2xl font-bold text-[#171717] dark:text-white">Forgot Password</h1>
      <p class="mt-2 text-sm text-[#75651d] dark:text-[#f5edbd]">Please contact your system administrator to reset your account password.</p>
      <div class="mt-6 border-t border-[#f1e8ae] dark:border-[#2d2d2d] pt-4">
        <a href="/login" class="inline-block rounded-xl bg-[#171717] dark:bg-[#f7d83d] px-6 py-2.5 text-sm font-bold text-[#f7d83d] dark:text-[#171717] hover:opacity-90 transition-all shadow-md">Back to Login</a>
      </div>
    </div>
  </div>
{{> footer}}
