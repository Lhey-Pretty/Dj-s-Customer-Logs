{{> head}}
<body class="bg-[#fffdf2] dark:bg-[#0f0f0f] min-h-screen">
  <div class="min-h-screen md:flex">
    {{> staffSidebar activeSection="promos"}}
    <main class="flex-1 px-4 py-8 lg:px-8">
      <header class="mb-6 rounded-2xl bg-[#171717] p-6 text-white shadow-lg">
        <p class="text-xs uppercase tracking-widest text-[#f7d83d] font-semibold">FoodHuB · Customer Logs</p>
        <h1 class="mt-2 text-3xl font-bold">Promo Records</h1>
        <p class="mt-2 text-[#f5edbd] opacity-80">View customer promo eligibility and redemption status.</p>
      </header>

      <section class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-6 shadow-sm mb-6">
        <h2 class="text-lg font-bold text-[#171717] dark:text-white">Record Redemption</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Select a customer and promo. The server verifies the purchase requirement before saving.</p>
        <form class="mt-4 grid gap-3 md:grid-cols-3" method="POST" action="/staff/promo-redemptions">
          <select class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="customerId" required>
            <option value="">Select customer</option>
            {{#each customers}}<option value="{{customerId}}">{{name}} · {{purchases}} purchase(s)</option>{{/each}}
          </select>
          <select class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="promoId" required>
            <option value="">Select active promo</option>
            {{#each promos}}<option value="{{promoId}}">{{name}} · needs {{minimumPurchases}} purchase(s)</option>{{/each}}
          </select>
          <button class="rounded-xl bg-[#171717] dark:bg-[#f7d83d] px-4 py-2.5 font-semibold text-[#f7d83d] dark:text-[#171717] hover:opacity-90 transition-all shadow-sm" type="submit">Record Redemption</button>
        </form>
      </section>

      <section class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-[#171717] dark:text-white">Promo Records</h2>
        </div>
        <form class="flex gap-2 mb-5" method="GET">
          <input class="w-full rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="search" value="{{search}}" placeholder="Search customer name, ID, or promo" />
          <button class="rounded-xl bg-[#171717] dark:bg-[#f7d83d] px-5 py-2.5 font-semibold text-[#f7d83d] dark:text-[#171717] hover:opacity-90 transition-all" type="submit">Search</button>
        </form>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[760px] text-left text-sm">
            <thead>
              <tr class="border-b border-[#ead36a] dark:border-[#2d2d2d]">
                <th class="p-3 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">Customer</th>
                <th class="p-3 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">Promo</th>
                <th class="p-3 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">Date</th>
                <th class="p-3 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">Eligibility</th>
                <th class="p-3 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">Status</th>
              </tr>
            </thead>
            <tbody>
              {{#each redemptions}}
              <tr class="border-b border-[#f1e8ae] dark:border-[#1f1f1f] hover:bg-[#fffdf2] dark:hover:bg-[#111] transition-colors">
                <td class="p-3"><p class="font-semibold text-[#171717] dark:text-white">{{customerName}}</p><p class="text-xs text-gray-500 dark:text-gray-400 font-mono mt-0.5">{{customerId}}</p></td>
                <td class="p-3 text-[#171717] dark:text-white">{{promoName}}</td>
                <td class="p-3 text-gray-500 dark:text-gray-400 text-xs">{{redemptionDate}}</td>
                <td class="p-3">
                  {{#ifEquals eligibilityStatus "Eligible"}}
                  <span class="rounded-full bg-green-100 dark:bg-green-900/30 px-3 py-1 text-xs font-semibold text-green-700 dark:text-green-400">Eligible</span>
                  {{else}}
                  <span class="rounded-full bg-red-100 dark:bg-red-900/30 px-3 py-1 text-xs font-semibold text-red-600 dark:text-red-400">Not Eligible</span>
                  {{/ifEquals}}
                </td>
                <td class="p-3"><span class="rounded-full bg-[#fff8d8] dark:bg-[#2a2500] px-3 py-1 text-xs font-semibold text-[#75651d] dark:text-[#f7d83d]">{{redeemedStatus}}</span></td>
              </tr>
              {{else}}
              <tr><td class="p-4 text-center text-gray-400 dark:text-gray-500" colspan="5">No promo records found.</td></tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
{{> footer}}
